# Local Java (IDE / mvn): copy to .env and fill DB_* / MAIL_* below.
# Docker Compose: run `docker compose up --build` from this repo.
#   Expects the frontend git repo as a sibling folder named `frontend`.
#   Compose Postgres is on host port 5433 (password POSTGRES_PASSWORD).
#   Mail in Docker goes to Mailpit (http://localhost:8025), not Gmail.
#   MAIL_USERNAME is still used as the From address and must look like an email.
#
# Optional Compose-only vars (defaults work without them):
# POSTGRES_DB=portail_b2b
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# NEXT_PUBLIC_API_URL=http://localhost:8081

# ==========================
# Database
# ==========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portail_b2b
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# ==========================
# Mail
# ==========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD="your_app_password"
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ==========================
# JWT
# ==========================
JWT_SECRET=your_32_or_64_byte_random_secret
JWT_EXPIRATION_MS=86400000

# ==========================
# CORS
# ==========================
CORS_ALLOWED_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGIN_IP=http://172.16.125.69:3000

# ==========================
# Account Activation
# ==========================
ACTIVATION_TOKEN_EXPIRATION_MS=604800000
FRONTEND_BASE_URL=http://localhost:3000
ACTIVATION_PATH=/activate

# ==========================
# Object storage (MinIO / S3)
# ==========================
# Local Java: start MinIO with `docker compose up minio` then use localhost.
# Compose overrides S3_ENDPOINT to http://minio:9000.
# Dev defaults match the MinIO service. Override in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lc-b2b-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE_ACCESS=true